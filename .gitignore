# ==========================================
# Production .gitignore - WearGuard Next.js
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Next.js Build Output
.next/
out/
build/
dist/

# Build & TypeScript Cache
*.tsbuildinfo
next-env.d.ts.bak

# Environment Variables & Secrets
.env
.env*.local
.env.production
.env.staging
*.env

# Debugging & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# OS Metadata & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Vercel Deployment Metadata
.vercel/

# Temporary / Scratch files & AI Agent state
.agents/
.tempmediaStorage/
.user_uploaded/
*.tmp
*.bak
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/

# Package manager locks (using npm)
pnpm-lock.yaml
yarn.lock

# Raw asset dumps & staging (kept locally)
public/new/

# Local scratch / utility scripts (keep optimize.mjs for package.json)
scripts/*
!scripts/optimize.mjs

